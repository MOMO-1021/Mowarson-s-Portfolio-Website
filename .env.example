# Production Database
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Preview / Staging Database (Isolated Neon Branch)
PREVIEW_DATABASE_URL=postgresql://user:password@preview-host/neondb?sslmode=require

# Payment Configuration
PAYMENT_MODE=test # 'test' for preview/staging, 'live' for production
RAZORPAY_KEY_ID=rzp_live_your_live_key
RAZORPAY_KEY_SECRET=your_live_secret
RAZORPAY_TEST_KEY_ID=rzp_test_your_test_key
RAZORPAY_TEST_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# PostHog Analytics
POSTHOG_PROJECT_TOKEN=phc_your_project_token
POSTHOG_HOST=https://your-posthog-host

# Meta CAPI & Test Tracking
PIXEL_ID=your_pixel_id
ACCESS_TOKEN=your_access_token
META_TEST_EVENT_CODE=TEST71947

# Brevo Email & Marketing
BREVO_API_KEY=your_brevo_api_key
BREVO_LIST_ID=your_prod_list_id
BREVO_TEST_LIST_ID=your_test_list_id

# Admin & Build Automation
NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/your_build_hook_id
ADMIN_API_KEY=your_secure_admin_api_key
