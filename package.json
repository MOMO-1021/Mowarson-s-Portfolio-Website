{
  "name": "mowarson-developer",
  "version": "1.0.0",
  "description": "Mowarson Developer Portfolio & Payment Portal",
  "main": "server.js",
  "scripts": {
    "build:blog": "node scripts/generate-blog.mjs",
    "publish:post": "node scripts/publish-post.mjs",
    "seo": "node scripts/generate-seo.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "build:preview": "node scripts/generate-blog.mjs && node scripts/generate-seo.mjs --preview && node scripts/validate-seo.mjs --preview",
    "build": "node scripts/generate-blog.mjs && node scripts/generate-seo.mjs && node scripts/validate-seo.mjs",
    "test:backend": "node tests/backend.test.mjs",
    "test:build": "node tests/build.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:seo": "node tests/seo.test.mjs",
    "test": "node tests/backend.test.mjs && node tests/build.test.mjs && node tests/browser.test.mjs && node tests/seo.test.mjs",
    "prestart": "npm run build",
    "start": "node server.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "posthog-js": "^1.453.0",
    "posthog-node": "^6.0.5",
    "razorpay": "^2.9.5"
  }
}
